# OGForge environment variables (names only — no real values here).
# The OG image API needs NO keys. Only live payments require Razorpay credentials;
# without them, checkout runs in mock/test mode and the full flow still works locally.

# Razorpay live or test credentials. When unset, RAZORPAY_MOCK is true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional test-key fallbacks (either pair is accepted by lib/razorpay.ts).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# Optional — only needed if you wire the Razorpay webhook for server-side confirmation.
RAZORPAY_WEBHOOK_SECRET=
